# ── Flask ───────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# ── Database (Neon) ─────────────────────────────────────────
# Neon serverless Postgres. There is no local database to install or start.
# Get these with neonctl and REDIRECT them -- never paste a connection string
# into a terminal, a commit or a chat (docs/DATABASE.md):
#
#   npm install -g neonctl && neonctl auth
#   neonctl connection-string dev --project-id dry-base-24522506 #     --org-id org-long-mud-04364433 --role-name aanga_owner #     --database-name aanga --pooled >> backend/.env
#
# Pooled ("-pooler" in the host) = the app. Direct = migrations, pg_dump, DDL.
# Never load a schema over the pooled string: schema.sql is a pg_dump and sets
# search_path to '', which PgBouncer leaves on the server connection for
# whoever gets it next, and then unqualified table names stop resolving.
DATABASE_URL=
DIRECT_DATABASE_URL=

# The Neon "test" branch. pytest TRUNCATEs every table in whatever it is given,
# so backend/tests/conftest.py refuses to run if this points at dev or
# production. Required -- there is no default.
TEST_DATABASE_URL=
TEST_DIRECT_DATABASE_URL=

# Optional belt and braces for the guard above: the production branch's
# endpoint, so a machine that never holds a production URL is still protected.
# Not a secret (it is a hostname label, not a credential).
NEON_PRODUCTION_ENDPOINT=ep-blue-resonance-b3eu3f6p

# ── CORS ────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Database connection pool (per gunicorn worker) ──────────
# workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW) must stay under the database's
# connection limit. Defaults suit 2 workers on a small managed Postgres.
# See docs/DEPLOYMENT.md "Sizing" before changing these or WEB_CONCURRENCY.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Web server (read by the gunicorn start command) ─────────────────────
WEB_CONCURRENCY=2
GUNICORN_THREADS=4

# ── Catalogue cache ─────────────────────────────────────────
# Public product / category / CMS responses are cached for up to a minute and
# dropped on any admin edit. Uses this Redis URL, else RATELIMIT_STORAGE_URI
# when that is Redis, else a small per-process cache.
CACHE_ENABLED=true
CACHE_REDIS_URL=

# ── Behind a proxy (production) ─────────────────────────────
# Number of reverse proxies in front of the app on the path the storefront
# uses. Read it off the admin System Health page ("Proxies in front of the
# server: N seen") after deploying, and check "Your IP as seen by the
# server" is your own.
TRUSTED_PROXY_COUNT=1
# Refresh-cookie SameSite in production. "Lax" when the storefront reaches the
# API through a same-origin /api rewrite; "None" only for a cross-site API.
JWT_COOKIE_SAMESITE=Lax

# ── Phone-OTP sign-in ───────────────────────────────────────
# Leave blank: no SMS provider is integrated, and the option is hidden on the
# storefront while this is empty.
SMS_PROVIDER=

# ── Rate limiting ───────────────────────────────────────────
# memory:// counts per worker, so with WEB_CONCURRENCY=2 a caller gets about
# twice the advertised allowance and nothing is shared between instances.
# Fine locally. In production point this at a managed Redis -- Upstash's free
# tier is ample for rate-limit counters:
#   Upstash -> Redis -> Create database (ap-south-1 / ap-southeast-1)
#   -> copy the redis:// (or rediss://) URL here.
# There is no Redis container any more; nothing to run locally.
RATELIMIT_STORAGE_URI=memory://

# Public storefront origin (absolute URLs in sitemap.xml / robots.txt / OG).
# Defaults to FRONTEND_ORIGIN. Set to the real domain in production.
SITE_URL=http://localhost:5173

# ── Observability (Sentry) ──────────────────────────────────
# Leave SENTRY_DSN blank to disable. traces sample rate 0.0–1.0.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_RELEASE=

# ── Google OAuth ────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Leave blank to disable "Continue with Google" (the endpoint answers 503).
GOOGLE_CLIENT_ID=

# ── Master Admin (used by: flask seed-admin) ────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Razorpay (online payments) ──────────────────────────────
# Razorpay Dashboard → Settings → API Keys. Leave blank to keep COD-only.
# Use test keys (rzp_test_...) until you're ready to go live.
# All-or-nothing in production: once a key is set, the secret and
# RAZORPAY_WEBHOOK_SECRET are required or the app refuses to start.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks. Subscribe to payment.captured,
# payment.failed and refund.processed, pointing at
#   https://<api-host>/api/payments/webhook
# Without this, a checkout abandoned after capture leaves the customer
# charged with no order and no refund.
RAZORPAY_WEBHOOK_SECRET=
# Seconds a capture may exist without an order before it counts as
# abandoned. Must comfortably exceed a normal checkout round-trip.
RAZORPAY_ORPHAN_GRACE_SECONDS=900

# ── Supabase Storage (product images) ───────────────────────
# REQUIRED in production. Render/Railway filesystems are ephemeral, so images
# saved to local disk are lost on every deploy. Without these the app refuses
# to start in production.
#   Supabase → Project Settings → API → Project URL / service_role key
#   Then create a PUBLIC bucket named below (Storage → New bucket).
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# ── Transactional email (Resend) ────────────────────────────
# Resend → API Keys. Leave RESEND_API_KEY blank to log emails instead of
# sending (local dev). EMAIL_FROM must be a verified sending domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=AANGA <orders@yourdomain.com>
EMAIL_ENABLED=true
# Send from a background thread so a slow mail provider never delays checkout.
EMAIL_ASYNC=true

# ── Shiprocket (delivery) ───────────────────────────────────
# Shiprocket → Settings → API → Create an API user, then use those creds.
# Leave blank to run without courier booking or delivery checks. All-or-nothing
# in production: once set, the password and SHIPROCKET_PICKUP_PINCODE are
# required or the app refuses to start.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as configured in Shiprocket (Settings → Pickup Addresses)
SHIPROCKET_PICKUP_LOCATION=Primary
# Origin PIN code for delivery/ETA checks on the storefront. Must match the
# pickup location registered in Shiprocket. Without it,
# /api/shipping/serviceability reports itself unconfigured and the
# storefront hides the delivery-check widget.
SHIPROCKET_PICKUP_PINCODE=
