# ── Flask ───────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# ── Database (dockerized Postgres) ──────────────────────────
# Start it with:  docker compose -f backend/docker-compose.yml up -d db
# These three drive the container (see docker-compose.yml) AND must match the
# DATABASE_URL below. Change POSTGRES_PASSWORD before anything leaves your box.
POSTGRES_USER=aanga
POSTGRES_PASSWORD=change-me-local-dev-password
POSTGRES_DB=aanga
# Host port. 5432/5433 are usually taken by a local Postgres install and 55432
# is the pytest database, hence 55433.
POSTGRES_PORT=55433

DATABASE_URL=postgresql://aanga:change-me-local-dev-password@localhost:55433/aanga

# ── Supabase Postgres (migration source only) ───────────────
# Only needed while migrating off Supabase, and by the schema re-dump.
# Supabase → Project Settings → Database → Connection string → "Session pooler".
# The direct db.<ref>.supabase.co host is IPv6-only and unreachable from inside
# a container, so the pooler URI is the one to use here.
#   Migrate:  cd backend; .\db\migrate-from-supabase.ps1
POOLER_DATABASE_URL=

# ── CORS ────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# Public storefront origin (absolute URLs in sitemap.xml / robots.txt / OG).
# Defaults to FRONTEND_ORIGIN. Set to the real domain in production.
SITE_URL=http://localhost:5173

# ── Observability (Sentry) ──────────────────────────────────
# Leave SENTRY_DSN blank to disable. traces sample rate 0.0–1.0.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_RELEASE=

# ── Google OAuth ────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Master Admin (used by: flask seed-admin) ────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Razorpay (online payments) ──────────────────────────────
# Razorpay Dashboard → Settings → API Keys. Leave blank to keep COD-only.
# Use test keys (rzp_test_...) until you're ready to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Supabase Storage (product images) ───────────────────────
# REQUIRED in production. Render/Railway filesystems are ephemeral, so images
# saved to local disk are lost on every deploy. Without these the app refuses
# to start in production.
#   Supabase → Project Settings → API → Project URL / service_role key
#   Then create a PUBLIC bucket named below (Storage → New bucket).
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# ── Transactional email (Resend) ────────────────────────────
# Resend → API Keys. Leave RESEND_API_KEY blank to log emails instead of
# sending (local dev). EMAIL_FROM must be a verified sending domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=AANGA <orders@yourdomain.com>
EMAIL_ENABLED=true

# ── Shiprocket (delivery) ───────────────────────────────────
# Shiprocket → Settings → API → Create an API user, then use those creds.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as configured in Shiprocket (Settings → Pickup Addresses)
SHIPROCKET_PICKUP_LOCATION=Primary
