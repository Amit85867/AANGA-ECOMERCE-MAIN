# ── Flask ───────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# ── Database (Supabase Postgres connection string) ──────────
# Supabase → Project Settings → Database → Connection string (URI)
# Use the "Session" pooler URI for local dev.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── CORS ────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Google OAuth ────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Master Admin (used by: flask seed-admin) ────────────────
ADMIN_EMAIL=admin@aanga.in
ADMIN_PASSWORD=AANGA@144amit

# ── Razorpay (online payments) ──────────────────────────────
# Razorpay Dashboard → Settings → API Keys. Leave blank to keep COD-only.
# Use test keys (rzp_test_...) until you're ready to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Shiprocket (delivery) ───────────────────────────────────
# Shiprocket → Settings → API → Create an API user, then use those creds.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as configured in Shiprocket (Settings → Pickup Addresses)
SHIPROCKET_PICKUP_LOCATION=Primary
