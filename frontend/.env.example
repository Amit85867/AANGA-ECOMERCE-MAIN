# Base URL of the API. Leave unset when the storefront and API share an origin
# (the Vite dev proxy locally, an /api rewrite in production) - it then
# defaults to /api, which keeps the refresh cookie first-party.
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth client id for "Continue with Google". Must match the backend's
# GOOGLE_CLIENT_ID. Leave blank to hide the button.
VITE_GOOGLE_CLIENT_ID=
